# Database
POSTGRES_USER=chronotrack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chronotrack
DATABASE_URL=postgresql+asyncpg://chronotrack:changeme@localhost:5432/chronotrack

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_REFRESH_SECRET_KEY=your-super-refresh-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000

# Telegram Bot (optional)
# TELEGRAM_TOKEN=your-telegram-bot-token
