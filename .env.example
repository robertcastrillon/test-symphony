# Database
DATABASE_URL=postgresql+asyncpg://chronotrack:chronotrack@db:5432/chronotrack
DATABASE_TEST_URL=postgresql+asyncpg://chronotrack:chronotrack@db:5432/chronotrack_test

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Telegram (optional)
TELEGRAM_TOKEN=

# Postgres credentials (for docker-compose)
POSTGRES_USER=chronotrack
POSTGRES_PASSWORD=chronotrack
POSTGRES_DB=chronotrack
